source "https://rubygems.org"

gem "jekyll", "~> 4.3.1"

# Jekyll 插件（须放在 :jekyll_plugins 组内才会被自动加载）
# 说明：本站 RSS 由手写的 atom.xml 提供，未使用 jekyll-feed 的 feed_meta；
#       _includes/head.html 也未使用 jekyll-seo-tag 的 {% seo %}，
#       因此这两个 gem 已移除。若日后要用，取消注释并执行 bundle install 即可。
group :jekyll_plugins do
  gem "jekyll-paginate"
  # gem "jekyll-feed"
  # gem "jekyll-seo-tag"
end
